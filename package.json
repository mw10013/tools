{
  "name": "tools",
  "version": "0.1.0",
  "private": true,
  "description": "CLI tools and automation",
  "type": "module",
  "imports": {
    "#berth/*": "./src/berth/*",
    "#bosun/*": "./src/bosun/*",
    "#devkit/*": "./src/devkit/*",
    "#devkit-cli/*": "./src/devkit-cli/*",
    "#refs/*": "./src/refs/*",
    "#tts/*": "./src/tts/*",
    "#wt/*": "./src/wt/*"
  },
  "scripts": {
    "berth": "vpx ./berth.ts",
    "bosun": "vpx ./bosun.ts",
    "devkit": "vpx ./devkit.ts",
    "prepare": "vp config",
    "refs": "vpx ./refs.ts",
    "tts": "vpx ./tts.ts",
    "wt": "vpx ./wt.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.2",
    "effect": "4.1.2",
    "linkedom": "0.18.12",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@effect/vitest": "4.1.2",
    "@types/node": "24.19.2",
    "@types/turndown": "5.0.6",
    "alchemy": "2.0.0-beta.85",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.0",
      "onFail": "ignore"
    }
  },
  "packageManager": "pnpm@12.11.2"
}
