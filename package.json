{
  "name": "tools",
  "version": "0.1.0",
  "private": true,
  "description": "CLI tools and automation",
  "type": "module",
  "imports": {
    "#refs/*": "./src/refs/*",
    "#tts/*": "./src/tts/*"
  },
  "scripts": {
    "prepare": "vp config",
    "refs": "vpx ./refs.ts",
    "tts": "vpx ./tts.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.5",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2"
}
